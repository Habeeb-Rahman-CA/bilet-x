{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bilet-x",
  "version": "0.1.0",
  "identifier": "com.bilet.x.app",
  "build": {
    "frontendDist": "../dist/bilet-x/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bilet-X Widget",
        "label": "main",
        "width": 640,
        "height": 440,
        "minWidth": 200,
        "minHeight": 200,
        "resizable": true,
        "fullscreen": false,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],





    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

